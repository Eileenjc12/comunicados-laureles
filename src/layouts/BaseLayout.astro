---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Urbanización Los Laureles — Portal Comunitario y Web Residencial',
  description = 'Canal institucional oficial de comunicados, quórum vecinal y directorio comercial de Urbanización Los Laureles.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es" class="h-full bg-slate-50 text-slate-900 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#065f46" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-full flex-col font-sans bg-slate-50 text-slate-800">
    <!-- Top Bar: Official Institutional Identity -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur shadow-sm border-b border-emerald-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Logo & Community Brand -->
          <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded-lg p-1">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-600 to-teal-800 flex items-center justify-center text-white shadow-md shadow-emerald-700/20 group-hover:scale-105 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <div>
              <span class="block text-xs font-semibold tracking-wider uppercase text-emerald-700">Comunidad Residencial</span>
              <span class="block text-lg font-bold text-slate-900 leading-tight">Los Laureles</span>
            </div>
          </a>

          <!-- Desktop Navigation -->
          <nav class="hidden md:flex items-center gap-1">
            <a
              href="/"
              class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                currentPath === '/' || currentPath.startsWith('/comunicados')
                  ? 'bg-emerald-50 text-emerald-800 font-semibold border border-emerald-200'
                  : 'text-slate-600 hover:text-emerald-700 hover:bg-slate-100'
              }`}
            >
              Comunicados
            </a>
            <a
              href="/mercado"
              class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                currentPath.startsWith('/mercado')
                  ? 'bg-emerald-50 text-emerald-800 font-semibold border border-emerald-200'
                  : 'text-slate-600 hover:text-emerald-700 hover:bg-slate-100'
              }`}
            >
              Mercado Laureles
            </a>
            <a
              href="/admin"
              class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                currentPath.startsWith('/admin')
                  ? 'bg-emerald-50 text-emerald-800 font-semibold border border-emerald-200'
                  : 'text-slate-600 hover:text-emerald-700 hover:bg-slate-100'
              }`}
            >
              Administración
            </a>
            <a
              href="#emergencias"
              class="ml-3 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100 transition-colors shadow-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              Emergencias
            </a>
          </nav>

          <!-- Mobile Hamburger Menu Button -->
          <div class="flex items-center md:hidden">
            <button
              id="mobile-menu-button"
              type="button"
              aria-label="Abrir menú de navegación"
              class="p-2 rounded-lg text-slate-600 hover:text-emerald-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
              <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg id="menu-icon-close" class="hidden w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-4 space-y-1 shadow-lg">
        <a
          href="/"
          class={`block px-3 py-2 rounded-lg text-base font-medium ${
            currentPath === '/' || currentPath.startsWith('/comunicados')
              ? 'bg-emerald-50 text-emerald-800 font-semibold'
              : 'text-slate-700 hover:bg-slate-50'
          }`}
        >
          Comunicados
        </a>
        <a
          href="/mercado"
          class={`block px-3 py-2 rounded-lg text-base font-medium ${
            currentPath.startsWith('/mercado')
              ? 'bg-emerald-50 text-emerald-800 font-semibold'
              : 'text-slate-700 hover:bg-slate-50'
          }`}
        >
          Mercado Laureles
        </a>
        <a
          href="/admin"
          class={`block px-3 py-2 rounded-lg text-base font-medium ${
            currentPath.startsWith('/admin')
              ? 'bg-emerald-50 text-emerald-800 font-semibold'
              : 'text-slate-700 hover:bg-slate-50'
          }`}
        >
          Administración
        </a>
        <a
          href="#emergencias"
          class="flex items-center gap-2 px-3 py-2 rounded-lg text-base font-medium text-rose-700 bg-rose-50 border border-rose-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Directorio de Emergencias
        </a>
      </div>
    </header>

    <!-- Main Dynamic Content Slot -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Community Footer -->
    <footer class="bg-slate-900 text-slate-300 border-t border-slate-800 mt-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Col 1: Identity -->
          <div>
            <div class="flex items-center gap-2 text-white font-bold text-lg mb-2">
              <span class="w-7 h-7 rounded bg-emerald-600 flex items-center justify-center text-xs">NL</span>
              Urbanización Los Laureles
            </div>
            <p class="text-sm text-slate-400 leading-relaxed">
              Junta Vecinal y Administración Residencial. Sistema oficial de notificación ciudadana, padrón de 52 predios y directorio comercial comunitario.
            </p>
          </div>

          <!-- Col 2: Quick Contacts -->
          <div>
            <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Atención Inmediata</h3>
            <ul class="text-sm space-y-2 text-slate-400">
              <li class="flex items-center gap-2">
                <span class="text-emerald-400 font-medium">Garita 1:</span>
                <a href="tel:+51987654321" class="hover:text-emerald-300 transition-colors">+51 987 654 321</a>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400 font-medium">Vigilancia 24/7:</span>
                <a href="tel:014567890" class="hover:text-emerald-300 transition-colors">(01) 456-7890</a>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400 font-medium">Administración:</span>
                <a href="https://wa.me/51999888777" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-300 transition-colors">WhatsApp 999 888 777</a>
              </li>
            </ul>
          </div>

          <!-- Col 3: Legal & Quorum -->
          <div>
            <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Validez Estatutaria</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              De acuerdo con el Estatuto de la Junta de Propietarios, el quórum formal para primera convocatoria requiere 50% + 1 (27 de 52 inmuebles). Toda confirmación de lectura registrada digitalmente cuenta con firma de inmueble para la asamblea.
            </p>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-800 text-center text-xs text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p>© 2026 Urbanización Los Laureles. Todos los derechos reservados.</p>
          <div class="flex items-center gap-4">
            <a href="/" class="hover:text-slate-300">Comunicados</a>
            <a href="/mercado" class="hover:text-slate-300">Mercado</a>
            <a href="/admin" class="hover:text-slate-300">Acceso Directiva</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Menu Toggle Script -->
    <script>
      const menuBtn = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      const openIcon = document.getElementById('menu-icon-open');
      const closeIcon = document.getElementById('menu-icon-close');

      if (menuBtn && mobileMenu && openIcon && closeIcon) {
        menuBtn.addEventListener('click', () => {
          const isHidden = mobileMenu.classList.contains('hidden');
          if (isHidden) {
            mobileMenu.classList.remove('hidden');
            openIcon.classList.add('hidden');
            closeIcon.classList.remove('hidden');
          } else {
            mobileMenu.classList.add('hidden');
            openIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
          }
        });
      }
    </script>
  </body>
</html>
