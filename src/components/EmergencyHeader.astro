---
// EmergencyHeader.astro
// Prominent 1-tap emergency action directory for Urbanización Los Laureles (R1)
---

<section id="emergencias" class="bg-gradient-to-r from-rose-900 via-red-800 to-rose-950 text-white py-4 px-4 sm:px-6 lg:px-8 shadow-md border-b-2 border-rose-600/50">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
      <!-- Title & Live Status -->
      <div class="flex items-center gap-2.5">
        <span class="relative flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-rose-500"></span>
        </span>
        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-rose-200">Central de Asistencia Inmediata</h2>
          <p class="text-sm font-semibold text-white">Directorio de Emergencias Urbanización Los Laureles</p>
        </div>
      </div>

      <!-- Action Pills: 1-Tap Call & Chat Targets -->
      <div class="flex flex-wrap items-center gap-2 pt-1 lg:pt-0">
        <!-- Portería Principal: Call -->
        <a
          href="tel:+51987654321"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 active:bg-white/30 border border-white/20 text-xs font-medium text-white transition-all backdrop-blur shadow-sm hover:scale-[1.02]"
          title="Llamar a Portería Principal Garita 1"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Portería: <strong class="font-semibold text-rose-100">+51 987 654 321</strong></span>
        </a>

        <!-- Portería: WhatsApp -->
        <a
          href="https://wa.me/51987654321?text=%C2%A1Hola%20Porter%C3%ADa!%20Me%20comunico%20desde%20mi%20inmueble%20por%20un%20asunto%20urgente."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-emerald-600/80 hover:bg-emerald-600 text-xs font-semibold text-white transition-all shadow-sm hover:scale-[1.02]"
          title="WhatsApp Portería"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>WA Garita</span>
        </a>

        <!-- Central Vigilancia 24/7 -->
        <a
          href="tel:014567890"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-xs font-medium text-white transition-all shadow-sm hover:scale-[1.02]"
          title="Llamar a Central Vigilancia 24/7"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>Vigilancia 24/7: <strong class="font-semibold text-rose-100">(01) 456-7890</strong></span>
        </a>

        <!-- Administración WhatsApp -->
        <a
          href="https://wa.me/51999888777?text=%C2%A1Hola%20Administraci%C3%B3n!%20Me%20comunico%20desde%20la%20Urbanizaci%C3%B3n%20Los%20Laureles."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-xs font-medium text-white transition-all shadow-sm hover:scale-[1.02]"
          title="WhatsApp Administración"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-teal-300" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>Admin: <strong class="font-semibold text-rose-100">999 888 777</strong></span>
        </a>

        <!-- Policía 105 -->
        <a
          href="tel:105"
          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full bg-blue-900/60 hover:bg-blue-800 border border-blue-400/40 text-xs font-semibold text-blue-100 transition-all shadow-sm hover:scale-[1.02]"
          title="Policía Nacional del Perú (105)"
        >
          <span>Policía: <strong>105</strong></span>
        </a>

        <!-- Bomberos 116 -->
        <a
          href="tel:116"
          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full bg-red-700/80 hover:bg-red-600 border border-red-300/40 text-xs font-semibold text-red-100 transition-all shadow-sm hover:scale-[1.02]"
          title="Bomberos Voluntarios (116)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
          </svg>
          <span>Bomberos: <strong>116</strong></span>
        </a>

        <!-- SAMU 106 -->
        <a
          href="tel:106"
          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full bg-emerald-800/80 hover:bg-emerald-700 border border-emerald-400/40 text-xs font-semibold text-emerald-100 transition-all shadow-sm hover:scale-[1.02]"
          title="SAMU Emergencias Médicas (106)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          <span>SAMU: <strong>106</strong></span>
        </a>
      </div>
    </div>
  </div>
</section>
